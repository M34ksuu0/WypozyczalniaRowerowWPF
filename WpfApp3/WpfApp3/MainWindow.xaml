<Window x:Class="WypozyczalniaRowerow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczalnia rowerów"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Naglowek -->
        <Border Background="#263238" Padding="20">
            <TextBlock Text="WYPOŻYCZALNIA ROWERÓW"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel dodawania -->
            <Border Grid.Column="0"
                    Background="White"
                    Padding="15"
                    CornerRadius="10"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="Dodaj rower"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="ID"/>
                    <TextBox x:Name="txtId" Margin="0,5,0,10"/>

                    <TextBlock Text="Opis"/>
                    <TextBox x:Name="txtOpis" Margin="0,5,0,10"/>

                    <TextBlock Text="Rodzaj"/>
                    <TextBox x:Name="txtRodzaj" Margin="0,5,0,10"/>

                    <TextBlock Text="Cena za godzinę"/>
                    <TextBox x:Name="txtCena" Margin="0,5,0,10"/>

                    <TextBlock Text="Zdjęcie roweru"/>
                    <TextBox x:Name="txtObrazek"
                             Text="rower1.jpg"
                             Margin="0,5,0,10"/>

                    <Button Content="Dodaj rower"
                            Height="35"
                            Background="#4CAF50"
                            Foreground="White"
                            Click="DodajRower_Click"
                            Margin="0,10,0,5"/>

                    <Button Content="Wypożycz rower"
                            Height="35"
                            Click="WypozyczRower_Click"
                            Margin="0,5"/>

                    <Button Content="Zwróć rower"
                            Height="35"
                            Click="ZwrocRower_Click"
                            Margin="0,5"/>

                    <Button Content="Odśwież listę"
                            Height="35"
                            Click="Odswiez_Click"
                            Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Lista rowerow -->
            <Border Grid.Column="1"
                    Background="White"
                    Padding="15"
                    CornerRadius="10">

                <DockPanel>
                    <TextBlock Text="Lista rowerów"
                               FontSize="22"
                               FontWeight="Bold"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="listaRowerow"
                             BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="5">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding ObrazekSciezka}"
                                               Width="110"
                                               Height="90"
                                               Stretch="UniformToFill"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="15,0,0,0">

                                            <TextBlock Text="{Binding Opis}"
                                                       FontSize="18"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding Id,
                                                StringFormat=ID: {0}}"/>

                                            <TextBlock Text="{Binding Rodzaj,
                                                StringFormat=Rodzaj: {0}}"/>

                                            <TextBlock Text="{Binding Cena,
                                                StringFormat=Cena/h: {0:F2} zł}"/>

                                            <TextBlock Text="{Binding Status}"/>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
